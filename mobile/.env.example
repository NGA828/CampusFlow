# Base URL of the CampusFlow API as the device can reach it.
#
# Copy to `.env` and set it to your machine's LAN address (`ipconfig`).
# This is DHCP-assigned, so it changes when you rejoin a network — the phone
# will then report the API as unreachable and show this exact URL.
#
#   Physical device (same WiFi): http://<your-lan-ip>:8001/api/v1
#   Android emulator:             http://10.0.2.2:8001/api/v1
#   iOS simulator:               http://localhost:8001/api/v1
EXPO_PUBLIC_API_URL=http://192.168.168.1:8001/api/v1