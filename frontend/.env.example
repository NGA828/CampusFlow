# CampusFlow — frontend environment (copy to .env.local)
# Never commit real secrets. This file only documents the expected variables.

# Base URL of the CampusFlow Laravel API (e.g. http://localhost:8000/api).
# When empty, the app runs in clearly-marked "mock" demo mode.
NEXT_PUBLIC_API_URL=

# Force API mode: "live" or "mock". Defaults to "mock" when NEXT_PUBLIC_API_URL
# is empty, otherwise "live".
NEXT_PUBLIC_API_MODE=mock
