{
  "name": "@campusflow/mobile",
  "version": "2.0.0",
  "private": true,
  "main": "index.ts",
  "description": "CampusFlow student app — QR positioning, GPS, indoor routing and bookings",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "build:web": "EXPO_OFFLINE=1 expo export --platform web --output-dir dist",
    "serve:web": "node tools/serve-web.mjs",
    "smoke:web": "node tools/smoke-web.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.0",
    "@maplibre/maplibre-react-native": "^10.2.0",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.0",
    "expo-location": "~19.0.0",
    "expo-notifications": "~0.32.0",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "maplibre-gl": "^5.24.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.4",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.2"
  }
}
